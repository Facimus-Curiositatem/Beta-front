# Plantilla de nginx. La imagen oficial reemplaza ${BACKEND_URL} al arrancar el contenedor.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Para los healthchecks de Docker y del pipeline
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # La API va al backend (VM beta-back) por la red local de la universidad
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 10m;
    }

    # Archivos con hash: cache larga
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de Angular: todo lo demas cae en index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
